                                "(function(){var s=(function(){var n=function(v){v=Number(v);return(isFinite(v)&&Math.abs(v)<1e9)?v:0;};var f=n(Telemetry.get(\"v1/gameData/Fuel\").value); if(!(f>0))f=n(Telemetry.get(\"v1/gameData/FuelRemains\").value); var lap=n(Telemetry.get(\"v1/gameData/CurrentLap\").value), per=0; if(!(f>0))return {f:0,per:0,laps:0};try{var g=(function(){return this;})()||{}; var T=g.__cnFuel||(g.__cnFuel={lap:-1,start:0,hist:[],dirty:false}); if(f>0&&lap>0){  if(T.lap<0||lap<T.lap){T.hist=[];T.lap=lap;T.start=f;T.dirty=true;}  else if(lap>T.lap){var u=T.start-f; if(lap===T.lap+1&&!T.dirty&&u>0.05&&u<30){T.hist.push(u);if(T.hist.length>5)T.hist.shift();}   T.lap=lap;T.start=f;T.dirty=false;}  else if(f>T.start+0.3){T.start=f;T.dirty=true;} } if(T.hist.length){var t=0;for(var i=0;i<T.hist.length;i++)t+=T.hist[i];per=t/T.hist.length;}}catch(e){}if(!(per>0))per=Math.abs(n(Telemetry.get(\"v1/gameData/FuelConsumeLap\").value));var laps=(per>0&&f>0)?f/per:n(Telemetry.get(\"v1/gameData/FuelLaps\").value); if(!(per>0)&&f>0&&laps>0)per=f/laps;return {f:Math.max(0,f),per:per,laps:laps};})(); return s.per>0?(s.per*0.264172).toFixed(2):\"--\";})()",
